# Think Tank Scanner Configuration

# Required: OpenRouter API key
# Create one at https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default model. Override per run with: python main.py --model provider/model-id
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Gmail SMTP settings for report delivery.
# Use a Gmail App Password, not your normal Gmail password.
SMTP_SENDER_EMAIL=your_gmail_address@gmail.com
SMTP_SENDER_PASSWORD=your_gmail_app_password_here

# Comma-separated recipient list.
SMTP_RECEIVER_EMAIL=recipient@example.com

# Optional runtime tuning.
SEEN_LEDGER_PATH=.scanner_state/seen_items.json
ENABLE_DDG_FALLBACK=false
MAX_NATIVE_CANDIDATES_PER_SOURCE=30
MAX_REVIEW_CANDIDATES_PER_SOURCE=25
LLM_BATCH_SIZE=3
FULL_TEXT_CHAR_LIMIT=12000
LLM_ITEM_TEXT_CHAR_LIMIT=6500
ENABLE_ENRICHMENT_CACHE=true

# Disable noisy sources by exact display name, separated with |
# Example:
# DISABLED_THINK_TANKS=Observer Research Foundation (ORF)|Example Institute
DISABLED_THINK_TANKS=Observer Research Foundation (ORF)
